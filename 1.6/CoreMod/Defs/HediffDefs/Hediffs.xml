<Defs>
<HediffDef>
<defName>InstantDeathm</defName>
<label>Death</label>
<description>I'm dead.</description>
<hediffClass>HediffWithComps</hediffClass>
<defaultLabelColor>(0.1,1.0, 0.7)</defaultLabelColor>
<lethalSeverity>0</lethalSeverity>
<canApplyDodChanceForCapacityChanges>true</canApplyDodChanceForCapacityChanges>
<makesSickThought>true</makesSickThought>
<scenarioCanAdd>true</scenarioCanAdd>
<isBad>false</isBad>
<everCurableByItem>false</everCurableByItem>
<stages>
<li>
<label>Instant Death</label>
<minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
</li>
</stages>
</HediffDef>

<HediffDef>
	<defName>DemiGhoul</defName>
	<label>Half-Ghoul</label>
	<description>This person has been turned into a being that is between life and death, granting them several bonuses at the cost of their psychic influence being severely dampened.</description>
	<everCurableByItem>false</everCurableByItem>
	<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
	<stages>
		<li>
			<painFactor>0</painFactor>
			<statFactors>
				<MaxNutrition>2</MaxNutrition>
				<PsychicSensitivity>0.10</PsychicSensitivity>
			</statFactors>
			<regeneration>25</regeneration>
			<statOffsets>
				<ComfyTemperatureMin>-40</ComfyTemperatureMin>
				<ComfyTemperatureMax>40</ComfyTemperatureMax>
				<MinimumContainmentStrength>35</MinimumContainmentStrength>
			</statOffsets>
		</li>
	</stages>
</HediffDef>
  
<HediffDef>
	<hediffClass>HediffWithComps</hediffClass>
	<defaultLabelColor>(1.0, 0, 0)</defaultLabelColor>
	<defName>VoidSootheSTNL</defName>
	<label>Void Regeneration</label>
	<description>This creature is being healed by dark archites.</description>
	<descriptionShort>This creature is being healed by dark archites.</descriptionShort>
	<isBad>false</isBad>
	<stages>
		<li>
			<regeneration>100</regeneration>
		</li>
	</stages>
	<comps>
		<li Class="HediffCompProperties_Disappears">
			<disappearsAfterTicks>2000</disappearsAfterTicks>
			<showRemainingTime>True</showRemainingTime>
		</li>
		<li Class="HediffCompProperties_Effecter">
			<stateEffecter>BiomutationPulserWarmup</stateEffecter>
		</li>
	</comps>
</HediffDef>
	
	 <HediffDef>
